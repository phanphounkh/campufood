# ─────────────────────────────────────────────────────────────
# CampusEats configuration. Copy to `.env` and fill in values:
#   cp .env.example .env
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (Docker) ─────────────────────────────────────
POSTGRES_DB=campuseats
POSTGRES_USER=campuseats
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ── Backend (FastAPI) ───────────────────────────────────────
# development | test | production
APP_ENV=development
# SQLAlchemy async URL (psycopg 3 driver). Must match the values above.
DATABASE_URL=postgresql+psycopg://campuseats:change-me@localhost:5432/campuseats
# Used by the pytest suite. The Docker init script creates `<POSTGRES_DB>_test`.
TEST_DATABASE_URL=postgresql+psycopg://campuseats:change-me@localhost:5432/campuseats_test
# Generate one: openssl rand -hex 32   (min. 32 chars; the API refuses to start in production with a weak value)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=720
# Send cookies only over HTTPS. Must be true in production.
COOKIE_SECURE=false
# Browser origins allowed to make state-changing requests (comma separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000
# Set true only when the API sits behind a trusted reverse proxy (e.g. the SvelteKit server).
TRUST_PROXY_HEADERS=true
# Enables the "Simulate Payment" endpoint. Must be false once a real provider is used.
DEMO_PAYMENTS_ENABLED=true
# Where uploaded food images are written (served at /media).
MEDIA_ROOT=./media
MAX_UPLOAD_MB=5

# ── Initial admin account (used once by scripts/seed.py) ────
# Leave the password empty to have a strong random one generated and printed once.
SEED_ADMIN_EMAIL=admin@campuseats.local
SEED_ADMIN_PASSWORD=

# ── Frontend (SvelteKit) ────────────────────────────────────
# Where the SvelteKit server forwards /api and /media requests.
API_INTERNAL_URL=http://127.0.0.1:8000
# Public URL of the web app (used by the full Docker stack).
PUBLIC_ORIGIN=http://localhost:3000
